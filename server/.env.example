# ============================================
# Interview Copilot AI — Environment Variables
# ============================================
# Copy this file to .env and fill in your real values.
# NEVER commit the .env file to Git.

# --- AI Providers ---
# OpenAI (Optional — Tier 1 priority if configured)
OPENAI_KEY=your_openai_key_here

# Google Gemini (Primary AI provider)
GEMINI_API_KEY=your_gemini_api_key_here

# Additional Gemini keys for failover / rate-limit rotation (Optional)
# The server auto-loads GEMINI_API_KEY_1 through GEMINI_API_KEY_20
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# --- Server ---
PORT=3000

# --- CORS ---
# Comma-separated list of allowed frontend origins
# Default allows Vercel deployment + localhost dev
CORS_ORIGINS=https://interview-copilot-aii.vercel.app,http://localhost:5173
